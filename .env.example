# Password for the login screen. Required when hosted; leave unset on your own machine to skip login.
APP_PASSWORD=
# Any long random string; changes the session cookie signature.
SESSION_SECRET=
# Public URL when hosted, e.g. https://growth.up.railway.app (used for redirects behind the proxy).
APP_URL=
# Where the SQLite database lives. Defaults to ./data; set to /data on Railway with a volume mounted there.
DATA_DIR=
# Optional. Enables the "What do these numbers mean?" explanations, written by Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Model for the explanations; defaults to claude-opus-5.
AI_MODEL=
